# PostgreSQL
POSTGRES_DB=show_da_biblia
POSTGRES_USER=show_da_biblia
POSTGRES_PASSWORD=admin
DATABASE_URL=postgresql://show_da_biblia:admin@localhost:5432/show_da_biblia
DB_DATABASE_URL=postgresql://show_da_biblia:admin@db:5432/show_da_biblia?sslmode=disable
DB_ATLAS=postgresql://show_da_biblia:admin@atlas-db:5432/dev?sslmode=disable

# API e JWT
APP_ENVIRONMENT=LOCAL
API_PORT=3000
JWT_SECRET=troque-por-um-segredo-longo-e-unico
JWT_SECRET_EXPIRES_IN=720h
# Recomendado: segredo exclusivo para códigos de recuperação. Sem ele, JWT_SECRET é usado.
PASSWORD_RESET_CODE_SECRET=troque-por-um-segredo-exclusivo-para-codigos-de-recuperacao
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.3:8081

# SMTP / recuperação de senha
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASSWORD=senha
SMTP_FROM=Show da Bíblia <nao-responda@example.com>
SMTP_SECURE=false

# Jogo / coringas
GAME_JOKER_ELIMINATION_QUANTITY=1
GAME_JOKER_REVEAL_QUANTITY=1

# MinIO / S3
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_BASE_URL=http://localhost:9002
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_BUCKET=show-da-biblia
S3_REGION=us-east-1
