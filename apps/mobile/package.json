{
  "name": "@show-da-biblia/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --lan",
    "dev:lan": "expo start --lan",
    "dev:clear": "expo start --lan --clear",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web --lan",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
