{
  "expo": {
    "name": "Show da Bíblia",
    "slug": "show-da-biblia",
    "version": "0.1.0",
    "scheme": "showdabiblia",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.showdabiblia.mobile"
    },
    "android": {
      "package": "com.showdabiblia.mobile"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Show da Bíblia acessa suas fotos somente para você escolher a imagem do seu perfil."
        }
      ]
    ]
  }
}
