{
  "expo": {
    "name": "Show da Bíblia",
    "slug": "show-da-biblia",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "showdabiblia",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.showdabiblia.mobile"
    },
    "android": {
      "package": "com.showdabiblia.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F8F3EB"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Show da Bíblia usa o Face ID para confirmar sua identidade e proteger sua sessão."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Show da Bíblia acessa suas fotos somente para você escolher a imagem do seu perfil."
        }
      ]
    ]
  }
}
