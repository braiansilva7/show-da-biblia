{
  "name": "show-da-biblia",
  "version": "0.1.0",
  "private": true,
  "description": "Base inicial do jogo Show da Bíblia.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:manager_api": "pnpm --filter manager_api dev",
    "dev:web": "pnpm --filter @show-da-biblia/web dev",
    "dev:mobile": "pnpm --filter @show-da-biblia/mobile dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up --build -d",
    "migrate": "pnpm --filter manager_api migrate"
  },
  "devDependencies": {
    "turbo": "^2.10.0"
  }
}
